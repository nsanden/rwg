---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import ColorGenerator from '../components/generators/ColorGenerator';

const title = 'Random Color Generator — Generate Colors with HEX, RGB & RAL Codes';
const description = 'Generate random colors with RAL codes, hex values, and RGB information. Perfect for design inspiration, artistic challenges, and creative projects.';
const keywords = ['random color generator', 'color picker', 'hex color', 'RGB color', 'RAL color', 'color palette', 'design colors'];
const ogImage = 'https://randomwordgenerator.com/img/color.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <ColorGenerator client:idle basePath={basePath} />
</GeneratorLayout>
