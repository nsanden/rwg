---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import PictionaryGenerator from '../components/generators/PictionaryGenerator';

const title = 'Pictionary Generator - Random Pictionary Words | RandomWordGenerator.com';
const description = 'Generate random Pictionary words instantly! Choose from easy to really hard difficulty levels. Perfect for family game night and parties.';
const keywords = ['pictionary generator', 'random pictionary words', 'pictionary game', 'drawing game', 'family games', 'party games'];
const ogImage = 'https://randomwordgenerator.com/img/pictionary.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <PictionaryGenerator client:load basePath={basePath} />
</GeneratorLayout>
