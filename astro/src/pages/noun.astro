---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import NounGenerator from '../components/generators/NounGenerator';

const title = 'Random Noun Generator — 1000+ Random Nouns';
const description = 'The Random Noun Generator includes 1000+ random nouns including proper, common, countable, uncountable, collective, concrete, abstract and pronouns.';
const keywords = ['random noun generator', 'nouns', 'random nouns', 'vocabulary', 'creative writing', 'word games'];
const ogImage = 'https://randomwordgenerator.com/img/random-noun-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <NounGenerator client:load basePath={basePath} />
</GeneratorLayout>
