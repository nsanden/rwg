---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import SentenceGenerator from '../components/generators/SentenceGenerator';

const title = 'Random Sentence Generator — 1000+ Random Sentences';
const description = 'The Random Sentence Generator contains 1000+ random sentences created specifically for this free writing tool and found nowhere else.';
const keywords = ['random sentence generator', 'sentences', 'random sentences', 'creative writing', 'writing prompts', 'writing tool'];
const ogImage = 'https://randomwordgenerator.com/img/random-sentence-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <SentenceGenerator client:load basePath={basePath} />
</GeneratorLayout>
