---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import NumberGenerator from '../components/generators/NumberGenerator';

const title = 'Random Number Generator — Easy Number Picker';
const description = 'The Random Number Generator produces random numbers within a chosen range. Pick a number with this random number picker.';
const keywords = ['random number generator', 'numbers', 'random numbers', 'number picker', 'random picker', 'lottery numbers'];
const ogImage = 'https://randomwordgenerator.com/img/random-number-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <NumberGenerator client:idle basePath={basePath} />
</GeneratorLayout>
