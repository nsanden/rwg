---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import BibleVersesGenerator from '../components/generators/BibleVersesGenerator';

const title = "Random Bible Verses — Enjoy Finding New Bible Scripture";
const description = "The Random Bible Verse Generator includes 31,000+ Bible verses from the Old and New Testament. Find inspiration with random verses for daily reading.";
const keywords = ['random bible verses', 'bible verse generator', 'daily bible verse', 'scripture', 'biblical quotes', 'verse of the day'];
const ogImage = 'https://randomwordgenerator.com/img/random-bible-verses.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <BibleVersesGenerator client:load basePath={basePath} />
</GeneratorLayout>
