---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import InterviewQuestionsGenerator from '../components/generators/InterviewQuestionsGenerator';

const title = 'Job Interview Questions';
const description = 'Learn how to interview better for your next job with these random interview questions.';
const keywords = ['interview questions', 'job interview', 'practice interview', 'interview preparation', 'job questions', 'interview skills'];
const ogImage = 'https://randomwordgenerator.com/img/interview-questions.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <InterviewQuestionsGenerator client:idle basePath={basePath} />
</GeneratorLayout>
