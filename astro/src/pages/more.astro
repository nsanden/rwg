---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import AllGeneratorsPage from '../components/generators/AllGeneratorsPage';

const title = 'More Random Generators — Random Word Generator';
const description = 'A list of all the random generators available on the website.';
const keywords = ['random generators', 'generator directory', 'random tools', 'word generators', 'number generators', 'name generators'];
const ogImage = 'https://randomwordgenerator.com/img/random-word-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <AllGeneratorsPage client:load basePath={basePath} />
</GeneratorLayout>
