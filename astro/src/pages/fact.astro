---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import FactsGenerator from '../components/generators/FactsGenerator';

const title = 'Random Facts — 1000+ Fun and Interesting Facts';
const description = 'The Random Fact Generator has 1000+ random facts including fun facts, interesting facts and amazing facts.';
const keywords = ['random facts', 'fun facts', 'interesting facts', 'amazing facts', 'trivia', 'knowledge'];
const ogImage = 'https://randomwordgenerator.com/img/random-facts.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <FactsGenerator client:load basePath={basePath} />
</GeneratorLayout>
