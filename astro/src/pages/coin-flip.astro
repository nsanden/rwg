---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import CoinFlipGenerator from '../components/generators/CoinFlipGenerator';

const title = 'Coin Flip — Instant Heads or Tails Results';
const description = 'The Coin Flip Generator is a coin toss coin flipper. Flip a coin and get a heads or tails result.';
const keywords = ['coin flip', 'coin toss', 'heads or tails', 'coin flipper', 'random decision', 'virtual coin'];
const ogImage = 'https://randomwordgenerator.com/img/coin-flip.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <CoinFlipGenerator client:idle basePath={basePath} />
</GeneratorLayout>
