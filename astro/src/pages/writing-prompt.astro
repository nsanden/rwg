---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import WritingPromptGenerator from '../components/generators/WritingPromptGenerator';

const title = 'Writing Prompts — Topic Ideas For Writing';
const description = 'The Writing Prompts generator helps you find random writing topics. Great for journal prompts and creative writing prompts.';
const keywords = ['random writing prompt generator', 'writing prompts', 'creative writing', 'story ideas', 'writing inspiration'];
const ogImage = 'https://randomwordgenerator.com/img/writing-prompts.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <WritingPromptGenerator client:load basePath={basePath} />
</GeneratorLayout>
