---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import FakeWordsGenerator from '../components/generators/FakeWordsGenerator';

const title = 'Fake Words — Find pseudo words and made up words';
const description = 'The Fake Word Generator creates fake words, pseudo words, made up words, nonsense words, and gibberish.';
const keywords = ['fake words', 'pseudo words', 'made up words', 'nonsense words', 'gibberish', 'word generator', 'artificial words'];
const ogImage = 'https://randomwordgenerator.com/img/fake-words.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <FakeWordsGenerator client:load basePath={basePath} />
</GeneratorLayout>
