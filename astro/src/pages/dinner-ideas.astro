---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import DinnerIdeasGenerator from '../components/generators/DinnerIdeasGenerator';

const title = 'Dinner Ideas Generator — 500+ Easy and Healthy Dinner Ideas';
const description = 'The Dinner Ideas Generator helps you find both healthy and easy dinner ideas. Get inspired with random dinner recipes when you can\'t decide what to cook.';
const keywords = ['dinner ideas', 'dinner ideas generator', 'what to make for dinner', 'easy dinner ideas', 'healthy dinner ideas', 'random dinner'];
const ogImage = 'https://randomwordgenerator.com/img/dinner-ideas-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <DinnerIdeasGenerator client:load basePath={basePath} />
</GeneratorLayout>
