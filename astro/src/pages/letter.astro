---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import LetterGenerator from '../components/generators/LetterGenerator';

const title = 'Random Letter Generator — Random letters from a to z';
const description = 'The Random Letter Generator allows you to generate random letters, English letters, capital letters and more!';
const keywords = ['random letter generator', 'letters', 'random letters', 'alphabet', 'capital letters', 'lowercase letters'];
const ogImage = 'https://randomwordgenerator.com/img/random-letter-generator.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <LetterGenerator client:idle basePath={basePath} />
</GeneratorLayout>
