---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import CharadesGenerator from '../components/generators/CharadesGenerator';

const title = 'Charades Generator — Random Charades Words for Your Game';
const description = 'Generate random charades words for your next game. Choose difficulty levels from easy to really hard, plus action words. Perfect for family game nights and parties.';
const keywords = ['charades generator', 'random charades words', 'charades game', 'family games', 'party games', 'charades ideas'];
const ogImage = 'https://randomwordgenerator.com/img/charades.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <CharadesGenerator client:load basePath={basePath} />
</GeneratorLayout>
