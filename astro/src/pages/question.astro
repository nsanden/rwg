---
import GeneratorLayout from '../layouts/GeneratorLayout.astro';
import QuestionGenerator from '../components/generators/QuestionGenerator';

const title = 'Random Questions — Generate random questions to ask';
const description = 'Generate random questions to ask. The Random Questions Generator creates random questions for conversation starters, writing prompts, and creative writing.';
const keywords = ['random questions', 'questions to ask', 'random question generator', 'conversation starters', 'writing prompts', 'creative writing'];
const ogImage = 'https://randomwordgenerator.com/img/random-questions.jpg';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<GeneratorLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
    <QuestionGenerator client:idle basePath={basePath} />
</GeneratorLayout>
