# Apache Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.randomwordgenerator\.com [NC]
    RewriteRule ^(.*)$ https://randomwordgenerator.com/$1 [L,R=301]

    # Pass /api requests to Laravel (don't rewrite)
    RewriteRule ^api/ - [L]

    # Serve .php URLs from Astro static pages (internal rewrite, not redirect)
    # This keeps URLs as .php but serves the static HTML
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)\.php$ /$1/ [L]
</IfModule>

# Legacy URL redirects (from old site)
